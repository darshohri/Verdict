# Backend environment variables for Verdict.
# Copy this file to .env and fill in your own values: cp .env.example .env
# Never commit your real .env file.

# Groq LLM inference for evaluations and the chat assistant
GROQ_API_KEY=your_groq_api_key

# Apify e-commerce review crawling actors
APIFY_API_TOKEN=your_apify_api_token
